PHOTOS_FOR_SITE/
NISEKO_JP/
# Raw photo drops live in date-prefixed folders; only the web-sized
# copies under photos_web/ get committed.
assets/[0-9]*/

# Dev tools — server-side only
face_detect.py
face_detect.swift
xml/

# Photo ingest — keep the tool + folder structure, ignore raw drops
_inbox/**
!_inbox/.gitkeep
!_inbox/README.txt
!_inbox/essays/
!_inbox/essays/README.txt

# macOS metadata
.DS_Store
**/.DS_Store
._*
**/._*
._.git
.claude/

# Raw photo/asset drops for OutroSpective — originals are ~900MB.
# Only the web-sized copies under photos_web/outrospective/ get committed.
assets/_OutroSpective/

# OutroSpective WIP imagery — only the assets the live page serves are
# committed (hero-bg + the share card). The rest stay local until the
# full deck ships.
photos_web/outrospective/*
